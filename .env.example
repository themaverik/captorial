# captorial configuration. Copy to .env and fill in; .env is gitignored.
#
#   cp .env.example .env
#
# Both CLIs load .env automatically via dotenv/config. Everything can also be set inline:
#
#   HEADED=true npm run replay -- specs/example-login.yaml
#
# Two different kinds of value live here. Tool config is read by the CLIs themselves. Spec vars are
# not: a spec declares `source: env:NAME` and the value is looked up at replay time, so which ones
# you need depends on the spec you are replaying.
#
# Never commit real hostnames, credentials, or session-state paths — keep them in .env only.


# --- Tool config: both record and replay -------------------------------------

# Base for a spec's relative `page:` paths and URL assertions.
# `npm run record` offers this as the default at its prompt rather than requiring it.
BASE_URL=

# Playwright storage-state file for an already-authenticated session, so a flow can start past the
# login screen. Optional. This file holds live session tokens: keep it gitignored (.auth/ is) and
# never commit it.
STORAGE_STATE=

# Slow every action down by N milliseconds when watching a flow. Default 0.
SLOWMO=


# --- Tool config: replay only ------------------------------------------------

# Where screenshots and their bounds sidecars are written. Default ./replay-output
OUTPUT_DIR=

# Capture viewport as WIDTHxHEIGHT, e.g. 1920x1080. Default 1920x1080 headless; headed shrinks it
# to fit the display it is running on, so the window actually shows the page.
VIEWPORT=

# Screenshot DPI multiplier; 2 gives retina-density output. Default 1
DEVICE_SCALE_FACTOR=

# Crop full-page shots into 16:9 tiles. Set false to get one untiled full-page PNG. Default true
CROP_169=

# Run the browser visibly instead of headless. Default false
HEADED=


# --- Spec vars ---------------------------------------------------------------
# Named by a spec's `vars` block, not by the CLIs. A hand-authored spec can use any names, so add
# whatever its `source: env:NAME` entries refer to.

# What `npm run record` emits for the credentials it collects. Their values are never written into
# the spec — the recorder holds them in memory for the session and stores only these names.
APP_EMAIL=
APP_PASSWORD=

# What the shipped specs/example-login.yaml refers to. Only needed to replay that example.
DEMO_EMAIL=
DEMO_PASSWORD=
